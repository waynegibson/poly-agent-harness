{
  "name": "@spacecomx/poly-agent-harness",
  "version": "0.1.0",
  "description": "One source of truth for portable agent skills and installable agent extensions.",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "bin": {
    "poly-agent-harness": "./bin/poly-agent-harness.mjs",
    "pah": "./bin/poly-agent-harness.mjs"
  },
  "files": [
    "bin",
    "schemas",
    "shared",
    "skills",
    "src",
    "polyharness.config.json",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "check": "pnpm run validate && pnpm run typecheck:packages && pnpm test",
    "doctor": "node ./bin/poly-agent-harness.mjs doctor",
    "list": "node ./bin/poly-agent-harness.mjs list",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck:packages": "pnpm --recursive --if-present run typecheck",
    "validate": "node ./bin/poly-agent-harness.mjs validate"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=11.19.0"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
